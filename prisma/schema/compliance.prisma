// ---------------------------------------------------------------------------
// Consent, waivers and compliance
//
// The platform manages storage, versioning and signature capture. It does NOT
// supply legal language: every shipped template carries
// `isLegalPlaceholder = true` and the editor surfaces the requirement that a
// qualified attorney draft and review the wording for the salon's own
// jurisdiction. See docs/COMPLIANCE.md.
// ---------------------------------------------------------------------------

enum FormKind {
  CONSENT
  WAIVER
  INTAKE
  POLICY
  PHOTO_RELEASE
  PATCH_TEST
  MINOR_GUARDIAN
  CHEMICAL_SERVICE
  EXTENSION
  CORRECTION_SERVICE
}

enum SignatureMethod {
  DRAWN
  TYPED
  CLICKWRAP
}

enum TestResult {
  PENDING
  NEGATIVE
  POSITIVE
  INCONCLUSIVE
}

enum StrandDecision {
  PROCEED
  MODIFY
  ABORT
}

enum GrantKind {
  PHOTO_RELEASE
  MARKETING_USE
  SMS
  EMAIL
  DATA_PROCESSING
  AI_PHOTO_ANALYSIS
  MINOR_GUARDIAN
  CHEMICAL_SERVICE
  EXTENSIONS
  CORRECTION_SERVICE
}

enum PolicyType {
  CANCELLATION
  NO_SHOW
  DEPOSIT_FORFEITURE
  RESCHEDULE
  PHOTO_USAGE
  LATE_ARRIVAL
  MINORS
}

model FormTemplate {
  id      String   @id @default(cuid())
  salonId String?
  salon   Salon?   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  key     String
  version Int      @default(1)
  name    String
  kind    FormKind
  bodyMarkdown String @db.Text
  schemaJson   Json?
  requiresSignature Boolean @default(true)
  validForDays      Int?
  appliesToServiceIds String[]
  /// TRUE for everything shipped with the platform. The UI refuses to hide
  /// the attorney-review notice while this is set.
  isLegalPlaceholder Boolean        @default(true)
  isSystem           Boolean        @default(false)
  status             TemplateStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  submissions FormSubmission[]

  @@unique([salonId, key, version])
  @@index([salonId, kind, status])
}

model FormSubmission {
  id             String       @id @default(cuid())
  salonId        String
  salon          Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  formTemplateId String
  formTemplate   FormTemplate @relation(fields: [formTemplateId], references: [id])
  templateVersion Int
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  servicePlanId  String?

  answersJson Json?
  submittedAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime? @db.Timestamptz(3)
  ipAddress   String?
  userAgent   String?
  /// Hash of the exact rendered document the client agreed to, so a later
  /// template edit can never change what they are shown to have signed.
  documentHash String

  signature     Signature?
  consentGrants ConsentGrant[]

  @@index([salonId, clientProfileId, submittedAt])
  @@index([salonId, formTemplateId])
}

model Signature {
  id               String         @id @default(cuid())
  salonId          String
  formSubmissionId String         @unique
  formSubmission   FormSubmission @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  signerUserId     String?
  signerName       String
  signerRelationship String?
  method           SignatureMethod @default(DRAWN)
  imageStorageKey  String?
  documentHash     String
  signedAt         DateTime        @default(now()) @db.Timestamptz(3)
  ipAddress        String?
  userAgent        String?

  @@index([salonId, signedAt])
}

model PatchTest {
  id              String        @id @default(cuid())
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  appointmentId   String?
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  servicePlanId   String?
  servicePlan     ServicePlan?  @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)

  productBrand String?
  productRef   String?
  appliedAt    DateTime   @db.Timestamptz(3)
  appliedByUserId String?
  readAt       DateTime?  @db.Timestamptz(3)
  result       TestResult @default(PENDING)
  notes        String?    @db.Text
  photoAssetId String?
  /// A patch test on file is only useful while it is current; the rules engine
  /// treats an expired one as absent.
  validUntil   DateTime   @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([salonId, clientProfileId, validUntil])
}

model StrandTest {
  id              String        @id @default(cuid())
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  consultationId  String?
  consultation    Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  servicePlanId   String?
  servicePlan     ServicePlan?  @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  formulaId       String?
  formula         Formula?      @relation(fields: [formulaId], references: [id], onDelete: SetNull)

  performedAt       DateTime       @db.Timestamptz(3)
  performedByUserId String
  startLevel        Int?
  liftAchievedLevel Int?
  integrityAfter    Elasticity?
  resultNotes       String?        @db.Text
  photoAssetIds     String[]
  decision          StrandDecision @default(PROCEED)

  @@index([salonId, clientProfileId, performedAt])
}

model ConsentGrant {
  id              String        @id @default(cuid())
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  kind            GrantKind
  scope           String?
  status          ConsentStatus @default(GRANTED)
  grantedAt       DateTime      @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime?     @db.Timestamptz(3)
  evidenceFormSubmissionId String?
  evidenceFormSubmission   FormSubmission? @relation(fields: [evidenceFormSubmissionId], references: [id], onDelete: SetNull)

  @@index([salonId, clientProfileId, kind])
}

model Policy {
  id            String     @id @default(cuid())
  salonId       String
  salon         Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  type          PolicyType
  version       Int        @default(1)
  bodyMarkdown  String     @db.Text
  configJson    Json
  effectiveFrom DateTime   @default(now()) @db.Timestamptz(3)
  isActive      Boolean    @default(true)

  acknowledgements PolicyAcknowledgement[]

  @@unique([salonId, type, version])
  @@index([salonId, type, isActive])
}

model PolicyAcknowledgement {
  id              String        @id @default(cuid())
  salonId         String
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  policyId        String
  policy          Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyVersion   Int
  acknowledgedAt  DateTime      @default(now()) @db.Timestamptz(3)
  ipAddress       String?

  @@index([salonId, clientProfileId])
}
