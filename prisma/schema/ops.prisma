// ---------------------------------------------------------------------------
// Operations, analytics, jobs and platform plumbing
// ---------------------------------------------------------------------------

enum ActorType {
  USER
  SYSTEM
  JOB
  AI
  PLATFORM_ADMIN
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
  CANCELLED
}

enum MetricPeriod {
  DAY
  WEEK
  MONTH
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
}

enum AiKind {
  CONSULTATION_SUMMARY
  PHOTO_ANALYSIS
  INSPIRATION_ATTRIBUTES
  RISK_EXPLAIN
  PLAN_NARRATIVE
  MESSAGE_DRAFT
  FORMULA_SUGGEST
  INTAKE_NORMALIZE
  SEGMENTATION
}

enum AiStatus {
  DRAFT
  ACCEPTED
  EDITED
  REJECTED
  FAILED
}

enum IntegrationProvider {
  GOOGLE_CALENDAR
  APPLE_ICAL
  STRIPE
  TWILIO
  RESEND
  SQUARE_POS
  QUICKBOOKS
  MAILCHIMP
  INSTAGRAM
  FACEBOOK
  GOOGLE_BUSINESS
}

model AuditLog {
  id        String    @id @default(cuid())
  salonId   String?
  salon     Salon?    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  actorType ActorType @default(USER)
  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole String?
  action    String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  reason     String?  @db.Text
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([salonId, createdAt])
  @@index([salonId, entityType, entityId])
  @@index([salonId, action])
}

/// Estimated vs actual, captured at checkout. This is what makes the quote
/// accuracy dashboard possible and what feeds StylistCalibration — the loop
/// that makes the platform's estimates get better the more it is used.
model QuoteAccuracy {
  id            String      @id @default(cuid())
  salonId       String
  salon         Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  servicePlanId String?
  stylistProfileId String
  stylistProfile   StylistProfile @relation(fields: [stylistProfileId], references: [id], onDelete: Cascade)

  serviceIds      String[]
  rulesetVersion  String?
  complexityScore Int      @default(0)

  estimatedDurationMin Int
  /// Chair time, not booked time — booked time expands to fill the slot and
  /// would make the calibration loop self-fulfilling.
  actualDurationMin    Int
  estimatedPriceCents  Int
  actualPriceCents     Int
  overranByMin         Int  @default(0)
  requiredInterleave   Boolean @default(false)
  factorsSnapshotJson  Json?
  computedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([salonId, stylistProfileId, computedAt])
  @@index([salonId, computedAt])
}

/// Per-stylist duration factor, shrunk toward 1.0 so a handful of unusual
/// appointments cannot swing a stylist's estimates.
model StylistCalibration {
  id               String         @id @default(cuid())
  salonId          String
  salon            Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylistProfileId String
  stylistProfile   StylistProfile @relation(fields: [stylistProfileId], references: [id], onDelete: Cascade)
  serviceId        String?
  service          Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  sampleCount  Int
  medianRatio  Decimal @db.Decimal(5, 3)
  p90Ratio     Decimal? @db.Decimal(5, 3)
  shrunkFactor Decimal @db.Decimal(5, 3)
  manualOverride Decimal? @db.Decimal(5, 3)
  windowStart  DateTime @db.Date
  windowEnd    DateTime @db.Date
  computedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([stylistProfileId, serviceId])
  @@index([salonId])
}

model MetricSnapshot {
  id          String       @id @default(cuid())
  salonId     String
  salon       Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  locationId  String?
  stylistProfileId String?
  period      MetricPeriod
  periodStart DateTime     @db.Date
  metricKey   String
  value       Decimal      @db.Decimal(18, 4)
  dimensionHash String     @default("")
  dimensionsJson Json?
  computedAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([salonId, period, periodStart, metricKey, dimensionHash])
  @@index([salonId, metricKey, periodStart])
}

model NoShowScore {
  id              String        @id @default(cuid())
  salonId         String
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  appointmentId   String
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  score        Decimal  @db.Decimal(4, 3)
  band         RiskBand
  featuresJson Json?
  modelVersion String
  computedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([salonId, appointmentId])
  @@index([salonId, band, computedAt])
}

/// Everything the model produced, with its cost and review state. Nothing here
/// reaches the rules engine until a human sets `status = ACCEPTED`, which
/// writes a real fact and triggers a fresh RuleEvaluation.
model AiSuggestion {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  kind    AiKind
  refType String
  refId   String

  model         String
  promptVersion String
  inputHash     String
  rawResponseJson Json?
  parsedJson      Json?
  editedJson      Json?
  status          AiStatus @default(DRAFT)
  reviewedByUserId String?
  reviewedAt      DateTime? @db.Timestamptz(3)

  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  costMicros Int      @default(0)
  latencyMs  Int      @default(0)
  errorCode  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([salonId, kind, status])
  @@index([salonId, refType, refId])
}

model AiUsageCounter {
  id         String   @id @default(cuid())
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  period     DateTime @db.Date
  tokensIn   BigInt   @default(0)
  tokensOut  BigInt   @default(0)
  costMicros BigInt   @default(0)
  callCount  Int      @default(0)

  @@unique([salonId, period])
}

/// Postgres-backed job queue. Claimed with FOR UPDATE SKIP LOCKED; no broker.
model Job {
  id      String @id @default(cuid())
  salonId String?
  queue   String @default("default")
  type    String
  payloadJson Json
  priority    Int       @default(100)
  runAt       DateTime  @default(now()) @db.Timestamptz(3)
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?   @db.Text
  lockedAt    DateTime? @db.Timestamptz(3)
  lockedBy    String?
  /// Prevents a retry or a re-materialisation from double-sending.
  dedupeKey   String?
  traceId     String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  @@index([status, queue, priority, runAt])
  @@index([status, lockedAt])
  @@index([salonId, type, createdAt])
}

model RecurringSchedule {
  key         String    @id
  cron        String
  jobType     String
  payloadJson Json?
  salonId     String?
  isEnabled   Boolean   @default(true)
  lastRunAt   DateTime? @db.Timestamptz(3)
  nextRunAt   DateTime  @db.Timestamptz(3)

  @@index([isEnabled, nextRunAt])
}

/// Transactional outbox: domain writes and event rows commit together, so a
/// booking confirmation is never lost because a provider was down at commit.
model Outbox {
  id          String    @id @default(cuid())
  salonId     String?
  topic       String
  payloadJson Json
  attempts    Int       @default(0)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([publishedAt, createdAt])
}

model IdempotencyKey {
  id           String    @id @default(cuid())
  salonId      String?
  scope        String
  key          String
  requestHash  String
  status       String    @default("IN_PROGRESS")
  responseJson Json?
  expiresAt    DateTime  @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
}

/// Registry of published rulesets. Global — a version means the same thing to
/// every salon, which is what makes a historical evaluation replayable.
model RulesetVersion {
  version     String   @id
  contentHash String
  gitSha      String?
  notes       String?  @db.Text
  isDefault   Boolean  @default(false)
  publishedAt DateTime @default(now()) @db.Timestamptz(3)

  pins SalonRulesetPin[]

  @@index([isDefault])
}

model SalonRulesetPin {
  id             String         @id @default(cuid())
  salonId        String         @unique
  salon          Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  rulesetVersion String
  /// Deliberately restrictive, unlike every salon-scoped relation: a published
  /// ruleset is global and immutable, and deleting one out from under a pinned
  /// salon would make its past evaluations unreplayable.
  ruleset        RulesetVersion @relation(fields: [rulesetVersion], references: [version], onDelete: Restrict)
  pinnedByUserId String?
  reason         String?
  pinnedAt       DateTime       @default(now()) @db.Timestamptz(3)
}

/// Salons may disable a rule or raise its severity floor. They may NOT author
/// new logic — rules stay in versioned TypeScript so they remain testable.
model SalonRuleOverride {
  id            String        @id @default(cuid())
  salonId       String
  ruleId        String
  isEnabled     Boolean       @default(true)
  severityFloor FlagSeverity?
  reason        String?       @db.Text
  updatedByUserId String?
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([salonId, ruleId])
  @@index([salonId, isEnabled])
}

model IntegrationConnection {
  id       String              @id @default(cuid())
  salonId  String
  salon    Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  provider IntegrationProvider
  /// Scoped to a stylist for personal calendar sync; null = salon-wide.
  stylistProfileId String?
  externalAccountId String?
  accessToken   String?   @db.Text
  refreshToken  String?   @db.Text
  expiresAt     DateTime? @db.Timestamptz(3)
  scopes        String[]
  settingsJson  Json?
  syncToken     String?
  lastSyncedAt  DateTime? @db.Timestamptz(3)
  lastError     String?   @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([salonId, provider, stylistProfileId])
  @@index([salonId, isActive])
}
