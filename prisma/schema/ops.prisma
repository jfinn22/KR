// ---------------------------------------------------------------------------
// Operations, analytics, jobs and platform plumbing
// ---------------------------------------------------------------------------

enum ActorType {
  USER
  SYSTEM
  JOB
  AI
  PLATFORM_ADMIN
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
  CANCELLED
}

enum AiKind {
  CONSULTATION_SUMMARY
  PHOTO_ANALYSIS
  INSPIRATION_ATTRIBUTES
  RISK_EXPLAIN
  PLAN_NARRATIVE
  MESSAGE_DRAFT
  FORMULA_SUGGEST
  INTAKE_NORMALIZE
  SEGMENTATION
}

enum AiStatus {
  DRAFT
  ACCEPTED
  EDITED
  REJECTED
  FAILED
}

enum IntegrationProvider {
  GOOGLE_CALENDAR
  APPLE_ICAL
  STRIPE
  TWILIO
  RESEND
  SQUARE_POS
  QUICKBOOKS
  MAILCHIMP
  INSTAGRAM
  FACEBOOK
  GOOGLE_BUSINESS
}

model AuditLog {
  id          String    @id @default(cuid())
  salonId     String?
  salon       Salon?    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  actorType   ActorType @default(USER)
  actorUserId String?
  actorUser   User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  reason      String?   @db.Text
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([salonId, createdAt])
  @@index([salonId, entityType, entityId])
  @@index([salonId, action])
}

/// Estimated vs actual, captured at checkout. This is what makes the quote
/// accuracy dashboard possible and what feeds StylistCalibration — the loop
/// that makes the platform's estimates get better the more it is used.
model QuoteAccuracy {
  id               String         @id @default(cuid())
  salonId          String
  salon            Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointmentId    String         @unique
  appointment      Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  servicePlanId    String?
  stylistProfileId String
  stylistProfile   StylistProfile @relation(fields: [stylistProfileId], references: [id], onDelete: Cascade)

  serviceIds      String[]
  rulesetVersion  String?
  complexityScore Int      @default(0)

  estimatedDurationMin Int
  /// Chair time, not booked time — booked time expands to fill the slot and
  /// would make the calibration loop self-fulfilling.
  actualDurationMin    Int
  estimatedPriceCents  Int
  actualPriceCents     Int
  overranByMin         Int      @default(0)
  requiredInterleave   Boolean  @default(false)
  factorsSnapshotJson  Json?
  computedAt           DateTime @default(now()) @db.Timestamptz(3)

  @@index([salonId, stylistProfileId, computedAt])
  @@index([salonId, computedAt])
}

/// Per-stylist duration factor, shrunk toward 1.0 so a handful of unusual
/// appointments cannot swing a stylist's estimates.
model StylistCalibration {
  id               String         @id @default(cuid())
  salonId          String
  salon            Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylistProfileId String
  stylistProfile   StylistProfile @relation(fields: [stylistProfileId], references: [id], onDelete: Cascade)
  serviceId        String?
  service          Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  sampleCount    Int
  medianRatio    Decimal  @db.Decimal(5, 3)
  p90Ratio       Decimal? @db.Decimal(5, 3)
  shrunkFactor   Decimal  @db.Decimal(5, 3)
  manualOverride Decimal? @db.Decimal(5, 3)
  windowStart    DateTime @db.Date
  windowEnd      DateTime @db.Date
  computedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([stylistProfileId, serviceId])
  @@index([salonId])
}

/// Everything the model produced, with its cost and review state. Nothing here
/// reaches the rules engine until a human sets `status = ACCEPTED`, which
/// writes a real fact and triggers a fresh RuleEvaluation.
model AiSuggestion {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  kind    AiKind
  refType String
  refId   String

  model            String
  promptVersion    String
  inputHash        String
  rawResponseJson  Json?
  parsedJson       Json?
  editedJson       Json?
  status           AiStatus  @default(DRAFT)
  reviewedByUserId String?
  reviewedAt       DateTime? @db.Timestamptz(3)

  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  costMicros Int      @default(0)
  latencyMs  Int      @default(0)
  errorCode  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([salonId, kind, status])
  @@index([salonId, refType, refId])
}

model AiUsageCounter {
  id         String   @id @default(cuid())
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  period     DateTime @db.Date
  tokensIn   BigInt   @default(0)
  tokensOut  BigInt   @default(0)
  costMicros BigInt   @default(0)
  callCount  Int      @default(0)

  @@unique([salonId, period])
}

/// Postgres-backed job queue. Claimed with FOR UPDATE SKIP LOCKED; no broker.
model Job {
  id          String    @id @default(cuid())
  salonId     String?
  queue       String    @default("default")
  type        String
  payloadJson Json
  priority    Int       @default(100)
  runAt       DateTime  @default(now()) @db.Timestamptz(3)
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?   @db.Text
  lockedAt    DateTime? @db.Timestamptz(3)
  lockedBy    String?
  /// Prevents a retry or a re-materialisation from double-sending.
  dedupeKey   String?
  traceId     String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  @@index([status, queue, priority, runAt])
  @@index([status, lockedAt])
  @@index([salonId, type, createdAt])
}

/// Transactional outbox: domain writes and event rows commit together, so a
/// booking confirmation is never lost because a provider was down at commit.
model Outbox {
  id          String    @id @default(cuid())
  salonId     String?
  topic       String
  payloadJson Json
  attempts    Int       @default(0)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([publishedAt, createdAt])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  salonId      String?
  scope        String
  key          String
  requestHash  String
  status       String   @default("IN_PROGRESS")
  responseJson Json?
  expiresAt    DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
}

/// Registry of published rulesets. Global — a version means the same thing to
/// every salon, which is what makes a historical evaluation replayable.
model RulesetVersion {
  version     String   @id
  contentHash String
  gitSha      String?
  notes       String?  @db.Text
  isDefault   Boolean  @default(false)
  publishedAt DateTime @default(now()) @db.Timestamptz(3)

  pins SalonRulesetPin[]

  @@index([isDefault])
}

model SalonRulesetPin {
  id             String         @id @default(cuid())
  salonId        String         @unique
  salon          Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  rulesetVersion String
  /// Deliberately restrictive, unlike every salon-scoped relation: a published
  /// ruleset is global and immutable, and deleting one out from under a pinned
  /// salon would make its past evaluations unreplayable.
  ruleset        RulesetVersion @relation(fields: [rulesetVersion], references: [version], onDelete: Restrict)
  pinnedByUserId String?
  reason         String?
  pinnedAt       DateTime       @default(now()) @db.Timestamptz(3)
}

/// Salons may disable a rule or raise its severity floor. They may NOT author
/// new logic — rules stay in versioned TypeScript so they remain testable.
model SalonRuleOverride {
  id              String        @id @default(cuid())
  salonId         String
  ruleId          String
  isEnabled       Boolean       @default(true)
  severityFloor   FlagSeverity?
  reason          String?       @db.Text
  updatedByUserId String?
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([salonId, ruleId])
  @@index([salonId, isEnabled])
}

model IntegrationConnection {
  id                String              @id @default(cuid())
  salonId           String
  salon             Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  provider          IntegrationProvider
  /// Scoped to a stylist for personal calendar sync; null = salon-wide.
  stylistProfileId  String?
  externalAccountId String?
  accessToken       String?             @db.Text
  refreshToken      String?             @db.Text
  expiresAt         DateTime?           @db.Timestamptz(3)
  scopes            String[]
  settingsJson      Json?
  syncToken         String?
  lastSyncedAt      DateTime?           @db.Timestamptz(3)
  lastError         String?             @db.Text
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([salonId, provider, stylistProfileId])
  @@index([salonId, isActive])
}

/// One attempt at an action taken by somebody with no account.
///
/// Signup, joining by code and claiming a booking link all happen before a
/// principal exists, so none of them can be rate-limited by user. They are
/// limited by (salon, action, fingerprint) over a window instead.
///
/// In the database rather than in memory on purpose: an in-process counter is
/// per-instance, and the whole point is to stop somebody hammering an endpoint
/// that creates accounts. Rows are swept by the existing stale-expiry job.
model PublicActionAttempt {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  /// The public action's own name, e.g. `client.signUp`. Not an authz Action.
  name        String
  /// Coarse and privacy-preserving: a hash of the caller's address, never the
  /// address itself. Enough to count with, useless to identify with.
  fingerprint String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([salonId, name, fingerprint, createdAt])
  @@index([createdAt])
}

/// Where a salon wants its own events delivered.
///
/// The signing machinery, the topic vocabulary and the emitter were all built
/// with the integrations work and nothing stored an endpoint, so there was
/// nowhere for an event to go — while the pricing page sold API_ACCESS. This
/// is the missing half.
///
/// The secret is stored in the clear on purpose, and it is the one credential
/// here that has to be: a signature the salon can verify requires that both
/// sides hold the same value, so it cannot be a one-way hash the way a feed
/// token is. It is never rendered after creation.
model WebhookEndpoint {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  url    String
  secret String
  /// Empty means every topic. Named topics mean only those.
  topics String[]

  isActive        Boolean   @default(true)
  lastDeliveredAt DateTime? @db.Timestamptz(3)
  lastError       String?   @db.Text
  /// Consecutive failures. A endpoint that has been dead for a long time stops
  /// being retried forever — a salon's queue should not be permanently full of
  /// deliveries to a URL nobody owns any more.
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([salonId, isActive])
}

/// One attempt to deliver one event to one endpoint.
///
/// Recorded rather than fire-and-forget, because "we sent it" is a claim a
/// salon will need to make to whoever is on the other end, and an unlogged
/// POST cannot support it.
model WebhookDelivery {
  id         String          @id @default(cuid())
  salonId    String
  salon      Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  topic        String
  payloadJson  Json
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?
  error        String?               @db.Text
  deliveredAt  DateTime?             @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)

  @@index([salonId, status, createdAt])
  @@index([endpointId, createdAt])
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

/// A commitment on a stylist's own calendar that the salon does not own.
///
/// Mirrored on a timer rather than fetched during a slot search. `externalBusy`
/// was written to be called from the solver, and doing that would put somebody
/// else's server in the booking hot path: every search would wait on Google,
/// and a slow token refresh would read to a client as "this salon has nothing
/// free". The loader reads these rows like any other blocked interval.
model ExternalBusy {
  id               String         @id @default(cuid())
  salonId          String
  salon            Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylistProfileId String
  stylistProfile   StylistProfile @relation(fields: [stylistProfileId], references: [id], onDelete: Cascade)

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  /// Which sync wrote it, so a re-sync can replace its own rows and only its
  /// own. Two connections for one stylist must not delete each other's work.
  source   String

  syncedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([salonId, stylistProfileId, startsAt])
  @@index([salonId, source])
}
