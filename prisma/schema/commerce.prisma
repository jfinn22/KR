// ---------------------------------------------------------------------------
// Commerce
//
// Money is integer cents everywhere. Payment state is never inferred from UI
// optimism — the provider is the source of truth, reconciled through webhooks.
// ---------------------------------------------------------------------------

enum DepositStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  APPLIED
  REFUNDED
  FORFEITED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  VOID
  REFUNDED
}

enum InvoiceLineKind {
  SERVICE
  RETAIL
  FEE
  DISCOUNT
  DEPOSIT_APPLIED
  GIFT_CARD
  TIP
}

enum PaymentMethod {
  CARD
  TERMINAL
  CASH
  ACCOUNT_CREDIT
  GIFT_CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FeeStatus {
  PENDING
  CHARGED
  WAIVED
  FAILED
}

enum ClientMembershipStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
}

enum ProductRecStatus {
  RECOMMENDED
  PURCHASED
  DECLINED
}

model Deposit {
  id              String        @id @default(cuid())
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  servicePlanId   String?
  appointmentId   String?
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  /// A paid consultation is a deposit against the assessment rather than the
  /// appointment. Same lifecycle, same machinery, same audit trail — a
  /// corrective consult that costs a stylist an hour is not free labour, and
  /// crediting it against the work is what keeps it from being a fee.
  consultationId  String?
  consultation    Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  /// The card this was or will be charged against.
  savedCardId String?
  savedCard   SavedCard? @relation(fields: [savedCardId], references: [id], onDelete: SetNull)

  amountCents            Int
  status                 DepositStatus @default(PENDING)
  providerIntentId       String?
  authorizationExpiresAt DateTime?     @db.Timestamptz(3)
  appliedToPaymentId     String?
  /// The bill this was spent on. Not derivable from `appointmentId`: a paid
  /// consultation is credited against the corrective work booked afterwards,
  /// which is a different appointment entirely.
  appliedToInvoiceId     String?
  appliedToInvoice       Invoice?      @relation(fields: [appliedToInvoiceId], references: [id], onDelete: SetNull)
  /// The deposit policy as it stood when the client agreed to it.
  policySnapshotJson     Json?
  refundableUntil        DateTime?     @db.Timestamptz(3)
  /// Why a charge failed, in the provider's words, so the client can be told
  /// something they can act on rather than "payment failed".
  failureCode            String?
  failureMessage         String?
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(3)

  /// The provider is the source of truth for payment state, and a webhook is
  /// how it says so. One live deposit per intent, so a redelivered event
  /// reconciles the row it already wrote rather than a second one.
  @@unique([providerIntentId])
  @@index([salonId, status])
  @@index([salonId, clientProfileId])
}

/// A card the client agreed we could keep.
///
/// Never a card number — only the provider's reference to one, plus the four
/// digits and the brand a person needs to recognise which card they are
/// looking at. Stealing every row of this table gets you nothing chargeable.
model SavedCard {
  id              String        @id @default(cuid())
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  providerRef String
  brand       String
  last4       String
  expMonth    Int
  expYear     Int
  isDefault   Boolean   @default(false)
  /// Removed by the client rather than deleted, because a deposit already
  /// charged against it still has to be explainable.
  detachedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  deposits Deposit[]

  @@unique([salonId, providerRef])
  @@index([salonId, clientProfileId, detachedAt])
}

model Invoice {
  id              String        @id @default(cuid())
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointmentId   String?       @unique
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  number        String
  status        InvoiceStatus @default(DRAFT)
  subtotalCents Int           @default(0)
  discountCents Int           @default(0)
  taxCents      Int           @default(0)
  tipCents      Int           @default(0)
  totalCents    Int           @default(0)
  paidCents     Int           @default(0)
  issuedAt      DateTime?     @db.Timestamptz(3)
  paidAt        DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  /// Why this bill is less than the price list. Nullable because most are not.
  discountReasonId         String?
  discountReason           DiscountReason? @relation(fields: [discountReasonId], references: [id], onDelete: SetNull)
  /// Required by the policy layer when the discount exceeded the giver's cap,
  /// and previously accepted by the action schema and read by nothing.
  discountNote             String?         @db.Text
  discountApprovedByUserId String?

  lines    InvoiceLine[]
  payments Payment[]
  deposits Deposit[]

  @@unique([salonId, number])
  @@index([salonId, status, issuedAt])
}

model InvoiceLine {
  id             String          @id @default(cuid())
  salonId        String
  invoiceId      String
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind           InvoiceLineKind
  refType        String?
  refId          String?
  description    String
  quantity       Int             @default(1)
  unitPriceCents Int
  totalCents     Int
  taxRateBps     Int             @default(0)
  sequence       Int             @default(0)

  /// What was taken off this line, after clamping. Computed in pricing.ts and
  /// previously thrown away — only the net survived, so a receipt could not
  /// show "was 95, now 80" and a month-end could not tell a discounted line
  /// from a cheap one.
  discountCents        Int  @default(0)
  /// What the client agreed to before anyone touched it at the till. Equal to
  /// unitPriceCents unless the price was edited, which is what makes an edit
  /// visible rather than merely effective.
  agreedUnitPriceCents Int?

  @@index([salonId, invoiceId])
}

/// A reason a bill is less than the price list says.
///
/// The till had a free-text amount and nothing else, so "£30 off" went onto the
/// record with no reason attached. A month later nobody could tell a staff
/// discount from a goodwill gesture from a colour that had to be redone —
/// three different facts about a salon, and only one of them a problem.
model DiscountReason {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  label     String
  kind      DiscountKind @default(PERCENT)
  /// PERCENT: basis points. FIXED: cents. OPEN: unused, the till names it.
  value     Int          @default(0)
  /// The owner's ceiling for this reason, independent of the role cap.
  maxCents  Int?
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  invoices Invoice[]

  @@unique([salonId, label])
  @@index([salonId, isActive, sortOrder])
}

enum DiscountKind {
  PERCENT
  FIXED
  /// The person at the till names the amount. Still needs a reason attached.
  OPEN
}

/// Money taken now for a service taken later.
///
/// The balance is NOT a column. It is the sum of the ledger below, because a
/// stored balance and a ledger that disagree is a fight with a customer holding
/// a piece of card, and the ledger is the side that can be audited.
model GiftCard {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  /// Shown to the buyer and typed in at redemption. Unique per salon, not
  /// globally: a card is a promise by one salon and means nothing at another.
  code         String
  initialCents Int
  status       GiftCardStatus @default(ACTIVE)
  expiresAt    DateTime?      @db.Timestamptz(3)

  /// Who bought it, when it was sold on a bill. Null for one issued by hand.
  purchasedByClientId String?
  purchasedBy         ClientProfile? @relation("GiftCardPurchaser", fields: [purchasedByClientId], references: [id], onDelete: SetNull)
  issuedOnInvoiceId   String?

  note      String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  entries GiftCardEntry[]

  @@unique([salonId, code])
  @@index([salonId, status])
}

enum GiftCardStatus {
  ACTIVE
  /// Spent to zero. Kept rather than deleted — it is still the record of a sale.
  REDEEMED
  EXPIRED
  VOID
}

/// Every movement on a gift card. Append-only; the balance is their sum.
model GiftCardEntry {
  id         String   @id @default(cuid())
  salonId    String
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  /// Positive on issue and top-up, negative on redemption.
  amountCents     Int
  kind            GiftCardEntryKind
  invoiceId       String?
  paymentId       String?
  /// One entry per (card, idempotency key). A double-tapped redemption at the
  /// till writes one row, not two, and the unique index is what enforces it
  /// rather than a check-then-write that races.
  idempotencyKey  String
  createdByUserId String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([giftCardId, idempotencyKey])
  @@index([salonId, giftCardId])
}

enum GiftCardEntryKind {
  ISSUE
  TOP_UP
  REDEEM
  REFUND
  ADJUSTMENT
}

model Payment {
  id              String        @id @default(cuid())
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  appointmentId   String?
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  amountCents    Int
  tipCents       Int           @default(0)
  method         PaymentMethod @default(CARD)
  status         PaymentStatus @default(PENDING)
  providerRef    String?
  /// Guards against the double-tap that dominates real-world duplicate charges.
  idempotencyKey String?       @unique
  failureCode    String?
  capturedAt     DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  refunds Refund[]

  @@index([salonId, status, createdAt])
  @@index([salonId, clientProfileId])
}

model Refund {
  id             String        @id @default(cuid())
  salonId        String
  paymentId      String
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents    Int
  reason         String?
  status         PaymentStatus @default(PENDING)
  providerRef    String?
  issuedByUserId String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([salonId, paymentId])
}

model CancellationFee {
  id                 String      @id @default(cuid())
  salonId            String
  appointmentId      String      @unique
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  policySnapshotJson Json
  computedCents      Int
  chargedCents       Int         @default(0)
  status             FeeStatus   @default(PENDING)
  waivedByUserId     String?
  waiveReason        String?     @db.Text
  paymentId          String?
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)

  @@index([salonId, status])
}

model ClientMembershipPlan {
  id              String  @id @default(cuid())
  salonId         String
  salon           Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name            String
  descriptionText String?
  priceCents      Int
  interval        String  @default("MONTH")
  includedJson    Json?
  stripePriceId   String?
  isActive        Boolean @default(true)

  memberships ClientMembership[]

  @@index([salonId, isActive])
}

model ClientMembership {
  id                   String                 @id @default(cuid())
  salonId              String
  clientProfileId      String
  clientProfile        ClientProfile          @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  planId               String
  plan                 ClientMembershipPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  status               ClientMembershipStatus @default(ACTIVE)
  startedAt            DateTime               @default(now()) @db.Timestamptz(3)
  /// The period the client has actually paid for.
  ///
  /// Both ends, because every piece of arithmetic a membership needs — what a
  /// plan change costs, how much of the fee is earned, how many free cuts are
  /// left — is a fraction of a period, and a single `renewsAt` cannot say how
  /// long the period was.
  currentPeriodStart   DateTime?              @db.Timestamptz(3)
  renewsAt             DateTime?              @db.Timestamptz(3)
  /// Asked to stop, but paid up until the period ends.
  ///
  /// Distinct from `cancelledAt`: somebody who cancels on the 3rd has bought
  /// the rest of the month and is entitled to it. Ending it the moment they
  /// click is taking money for a service withdrawn.
  cancelAtPeriodEnd    Boolean                @default(false)
  cancelledAt          DateTime?              @db.Timestamptz(3)
  /// When the payment first failed, which is what the dunning clock runs from.
  pastDueSince         DateTime?              @db.Timestamptz(3)
  creditsRemaining     Int                    @default(0)
  stripeSubscriptionId String?

  benefitUses MembershipBenefitUse[]

  @@index([salonId, status])
  @@index([salonId, stripeSubscriptionId])
}

/// One use of one membership benefit.
///
/// A ledger rather than a counter on the membership, for the reason every other
/// counter in this platform has taught: a running total is a number somebody
/// has to remember to keep right, and when it drifts there is nothing to check
/// it against. Rows can be counted per period, and a refunded invoice can take
/// its own use back out.
model MembershipBenefitUse {
  id             String           @id @default(cuid())
  salonId        String
  membershipId   String
  membership     ClientMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  invoiceId      String?
  /// Identifies WHICH entitlement, so an allowance is per benefit and not per
  /// membership — a plan with a free cut and a discounted colour has two.
  entitlementKey String
  label          String
  discountCents  Int
  /// The period it was used in, so an allowance resets without anybody sweeping.
  periodStart    DateTime         @db.Timestamptz(3)
  usedAt         DateTime         @default(now()) @db.Timestamptz(3)

  @@index([salonId, membershipId, periodStart])
  @@index([salonId, invoiceId])
}

model RetailProduct {
  id                  String  @id @default(cuid())
  salonId             String
  salon               Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  sku                 String
  name                String
  brand               String?
  category            String?
  priceCents          Int
  costCents           Int     @default(0)
  /// Grams in one unit, for anything mixed at the bowl.
  ///
  /// Backbar cost is per gram and a purchase is per tube, and nothing else in
  /// the schema bridges the two. Null rather than a default: a guessed tube
  /// size reports a made-up margin, and an owner acts on a margin they believe.
  backbarGramsPerUnit Int?
  /// Used on clients rather than sold to them. Both is common — the same
  /// shampoo goes on the shelf and in the basin.
  isBackbar           Boolean @default(false)
  stockQty            Int     @default(0)
  reorderLevel        Int     @default(0)
  attributesJson      Json?
  isActive            Boolean @default(true)

  usage           ProductUsage[]
  recommendations ProductRecommendation[]

  @@unique([salonId, sku])
  @@index([salonId, isActive])
}

/// Back-bar consumption. `wasteGrams` is what drives the product-waste KPI —
/// the difference between mixed and used is real money.
model ProductUsage {
  id            String         @id @default(cuid())
  salonId       String
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  productId     String?
  product       RetailProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String?
  grams         Decimal        @db.Decimal(7, 1)
  wasteGrams    Decimal        @default(0) @db.Decimal(7, 1)
  costCents     Int            @default(0)
  recordedAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([salonId, appointmentId])
}

model ProductRecommendation {
  id                  String           @id @default(cuid())
  salonId             String
  clientProfileId     String
  clientProfile       ClientProfile    @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  appointmentId       String?
  appointment         Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  retailProductId     String
  retailProduct       RetailProduct    @relation(fields: [retailProductId], references: [id], onDelete: Cascade)
  recommendedByUserId String?
  reason              String?          @db.Text
  status              ProductRecStatus @default(RECOMMENDED)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)

  @@index([salonId, clientProfileId, status])
}
