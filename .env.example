# ---------------------------------------------------------------------------
# Salon Intelligence Platform — environment
#
# These defaults run the ENTIRE platform with no third-party accounts and no
# API keys. Every integration resolves to its mock adapter. Copy to `.env`:
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# `pnpm db:up` starts the system Postgres cluster and creates these databases.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/salon_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/salon_test?schema=public"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth ------------------------------------------------------------------
# Any non-empty string works locally. Generate a real one with:
#   openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-in-production"
AUTH_TRUST_HOST="true"

# --- Adapters --------------------------------------------------------------
# Global default for every port. `mock` needs no credentials whatsoever.
ADAPTER_MODE="mock"

# Per-port overrides. Each falls back to ADAPTER_MODE when unset.
# PAYMENTS_ADAPTER="real"
# SMS_ADAPTER="real"
# EMAIL_ADAPTER="real"
# STORAGE_ADAPTER="real"
# AI_ADAPTER="real"
# CALENDAR_ADAPTER="real"
# ESIGN_ADAPTER="real"

# Where the mock storage adapter writes uploaded images.
MOCK_STORAGE_DIR="./.uploads"

# --- Jobs ------------------------------------------------------------------
# Shared secret guarding /api/cron/[job]. Required in production.
CRON_SECRET="dev-only-cron-secret"
WORKER_POLL_MS="2000"
WORKER_BATCH_SIZE="10"

# ---------------------------------------------------------------------------
# Real adapter credentials — ONLY needed when the matching *_ADAPTER is "real".
# Leave every one of these blank for local development.
# ---------------------------------------------------------------------------

# Stripe — deposits, balances, refunds, subscription billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_SALON=""

# Twilio — SMS reminders and two-way messaging
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Resend — transactional email
RESEND_API_KEY=""
EMAIL_FROM="Salon <noreply@example.com>"

# S3 / R2 — client and inspiration photo storage
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Anthropic — consultation summaries, photo observations, draft messages.
# The AI layer is advisory only; it never gates a booking or produces a risk verdict.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_MODEL_HEAVY="claude-opus-5"

# Google Calendar — two-way stylist calendar sync
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
